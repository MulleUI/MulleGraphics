	"#version 420 core\n"
	"\n"
	"in vec2 pos;                    // screen position <-1,+1>\n"
	"out vec4 gl_FragColor;          // fragment output color\n"
	"uniform sampler2D txr;          // texture to blur\n"
	"uniform float xs,ys;            // texture resolution\n"
	"uniform float r;                // blur radius\n"
	"uniform int axis;\n"
	"\n"
	"void main()\n"
	"    {\n"
	"    float x,y,rr=r*r,d,w,w0;\n"
	"    vec2 p=0.5*(vec2(1.0,1.0)+pos);\n"
	"    vec4 col=vec4(0.0,0.0,0.0,0.0);\n"
	"    w0=0.5135/pow(r,0.96);\n"
	"    if (axis==0) for (d=1.0/xs,x=-r,p.x+=x*d;x<=r;x++,p.x+=d){ w=w0*e"
	"xp((-x*x)/(2.0*rr)); col+=texture2D(txr,p)*w; }\n"
	"    if (axis==1) for (d=1.0/ys,y=-r,p.y+=y*d;y<=r;y++,p.y+=d){ w=w0*e"
	"xp((-y*y)/(2.0*rr)); col+=texture2D(txr,p)*w; }\n"
	"    gl_FragColor=col;\n"
	"    }\n"
